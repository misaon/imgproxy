{
  "name": "@misaon/imgproxy",
  "version": "1.1.0",
  "description": "Generate signed imgproxy URLs in the browser, Node.js and edge runtimes. Zero dependencies, tiny and fast.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misaon/imgproxy.git"
  },
  "homepage": "https://github.com/misaon/imgproxy#readme",
  "bugs": "https://github.com/misaon/imgproxy/issues",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "tsdown",
    "dev": "vitest --project unit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build",
    "release": "pnpm test && pnpm build && pnpm test:smoke && changelogen --release --no-github && npm publish && git push --follow-tags && changelogen gh release",
    "test": "pnpm lint && pnpm typecheck && vitest run --project unit --coverage",
    "test:e2e": "vitest run --project e2e",
    "test:smoke": "node test/smoke/esm.mjs && node test/smoke/cjs.cjs"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "imgproxy",
    "image",
    "url",
    "signature",
    "hmac",
    "resize",
    "thumbnail"
  ],
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@misaon/imgproxy-v1": "npm:@misaon/imgproxy@1.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "changelogen": "^0.6.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-xo": "^7.0.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
